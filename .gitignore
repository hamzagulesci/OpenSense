# hardware test reports)
*.toml.bad
*.toml.tmp
*.toml.*.tmp
*.exe.old
*.exe.old.*
opensense-report-*.json
opensense-battery-report.html
opensense-scan.txt

# Logs and traces
*.log
*.etl

# Scratch files
*.bak
*.orig
*.rej
*.tmp

# Editors and IDEs
.vscode/
.idea/
.vs/
*.code-workspace
*.swp
*~

# Operating system files
Thumbs.db
desktop.ini
.DS_Store

# Local tool state
.claude/
graphify-out/
.graphify_*

# Local notes (review findings that are still open)
/KNOWN_ISSUES.md
