# Rust build output
/target/
*.pdb
**/*.rs.bk

# Installer and release output
/dist/
/zip/
/installer/opensense.ico
/installer/Output/
*.zip
SHA256SUMS.txt

# Third-party reference sources, not part of OpenSense
/.references/
/g-helper-main/
/g-helper-*/

